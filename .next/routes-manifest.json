{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/patient-portal/[visitToken]",
      "regex": "^/api/patient\\-portal/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPvisitToken": "nxtPvisitToken"
      },
      "namedRegex": "^/api/patient\\-portal/(?<nxtPvisitToken>[^/]+?)(?:/)?$"
    },
    {
      "page": "/p/[visitId]",
      "regex": "^/p/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPvisitId": "nxtPvisitId"
      },
      "namedRegex": "^/p/(?<nxtPvisitId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/checked",
      "regex": "^/checked(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/checked(?:/)?$"
    },
    {
      "page": "/checkin",
      "regex": "^/checkin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/checkin(?:/)?$"
    },
    {
      "page": "/clinic",
      "regex": "^/clinic(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/clinic(?:/)?$"
    },
    {
      "page": "/clinic/calendar",
      "regex": "^/clinic/calendar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/clinic/calendar(?:/)?$"
    },
    {
      "page": "/clinic/case",
      "regex": "^/clinic/case(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/clinic/case(?:/)?$"
    },
    {
      "page": "/clinic/dashboard",
      "regex": "^/clinic/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/clinic/dashboard(?:/)?$"
    },
    {
      "page": "/clinic/document",
      "regex": "^/clinic/document(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/clinic/document(?:/)?$"
    },
    {
      "page": "/clinic/profile",
      "regex": "^/clinic/profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/clinic/profile(?:/)?$"
    },
    {
      "page": "/clinic/settings",
      "regex": "^/clinic/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/clinic/settings(?:/)?$"
    },
    {
      "page": "/consent",
      "regex": "^/consent(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/consent(?:/)?$"
    },
    {
      "page": "/register",
      "regex": "^/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/register(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}